+/// FastPDF experiment: replaces the start-up WARP devices with hardware devices created in
+/// the background. The device-lost path, minus its waits: those give a lost device time to
+/// recover, and nothing is lost here.
+fn switch_gpu_devices(
+    directx_devices: &mut DirectXDevices,
+    ready: DirectXDevices,
+    platform_window: HWND,
+    validation_number: usize,
+    all_windows: &std::sync::Weak<RwLock<SmallVec<[TrackedWindow; 4]>>>,
+    text_system: &std::sync::Weak<DirectWriteTextSystem>,
+) -> Result<()> {
+    test_event("gpu_switch_begin");
+    *directx_devices = ready;
+    let lparam = LPARAM(directx_devices as *const _ as _);
+    unsafe {
+        SendMessageW(
+            platform_window,
+            WM_GPUI_GPU_DEVICE_LOST,
+            Some(WPARAM(validation_number)),
+            Some(lparam),
+        );
+    }
+    if let Some(text_system) = text_system.upgrade() {
+        text_system.handle_gpu_lost(directx_devices)?;
+    }
+    if let Some(all_windows) = all_windows.upgrade() {
+        for window in all_windows.read().iter() {
+            unsafe {
+                SendMessageW(
+                    window.as_raw(),
+                    WM_GPUI_GPU_DEVICE_LOST,
+                    Some(WPARAM(validation_number)),
+                    Some(lparam),
+                );
+            }
+        }
+        for window in all_windows.read().iter() {
+            unsafe {
+                SendMessageW(
+                    window.as_raw(),
+                    WM_GPUI_FORCE_UPDATE_WINDOW,
+                    Some(WPARAM(validation_number)),
+                    None,
+                );
+            }
+        }
+    }
+    test_event("gpu_switch_end");
+    Ok(())
+}
