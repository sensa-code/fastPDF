+/// FastPDF experiment only (docs/research/warp-first-startup.md), not shipped: prints a
+/// `{"event":..,"t_ms":..}` line like FastPDF's FASTPDF_BENCH milestones, timed from process
+/// creation, so bench-app records GPU milestones next to the app's own.
+pub(crate) fn test_event(name: &str) {
+    static ENABLED: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
+    if !*ENABLED.get_or_init(|| std::env::var_os("FASTPDF_BENCH").is_some()) {
+        return;
+    }
+    use std::io::Write;
+    use windows::Win32::Foundation::FILETIME;
+    use windows::Win32::System::SystemInformation::GetSystemTimePreciseAsFileTime;
+    use windows::Win32::System::Threading::{GetCurrentProcess, GetProcessTimes};
+    let ticks = |t: FILETIME| ((t.dwHighDateTime as u64) << 32) | t.dwLowDateTime as u64;
+    let mut creation = FILETIME::default();
+    let mut exit = FILETIME::default();
+    let mut kernel = FILETIME::default();
+    let mut user = FILETIME::default();
+    let ok = unsafe {
+        GetProcessTimes(
+            GetCurrentProcess(),
+            &mut creation,
+            &mut exit,
+            &mut kernel,
+            &mut user,
+        )
+    };
+    if ok.is_err() {
+        return;
+    }
+    let now = unsafe { GetSystemTimePreciseAsFileTime() };
+    let ms = ticks(now).saturating_sub(ticks(creation)) as f64 / 10_000.0;
+    let _ = writeln!(
+        std::io::stdout().lock(),
+        "{{\"event\":\"{name}\",\"t_ms\":{ms:.3}}}"
+    );
+}
